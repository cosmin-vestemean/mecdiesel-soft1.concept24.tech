# S1 (SoftOne) MCP — per-project environment contract
#
# This server is registered ONCE, globally (User mcp.json / ~/.copilot/mcp-config.json).
# Each PROJECT supplies its own values below via its OWN .env at the project root
# (loaded through mcp.json's "envFile": "${workspaceFolder}/.env" — see VS Code's
# MCP configuration reference). Never commit real values; this file only documents
# the contract and is safe to keep as a template.

# --- Credentials (required) ---
S1_WS_USR=
S1_WS_PASS=

# --- Connection (required: at least one of the two URLs, matching S1_ENV) ---
S1_APP_ID=1001
S1_PROD_URL=
S1_TEST_URL=
# prod | test. SAFE DEFAULT if unset: test. Set explicitly to prod for
# projects that only ever talk to production.
S1_ENV=test

# --- Default auth selection (optional; falls back to login's first permission) ---
S1_DEFAULT_COMPANY=
S1_DEFAULT_BRANCH=
S1_DEFAULT_MODULE=
S1_DEFAULT_REFID=

# --- SQL endpoint (optional; project-specific deployed AJS endpoint) ---
S1_SQL_ENDPOINT_PATH=/JS/Utile/getSQLDataSet

# --- Custom /JS/WS/* proxy auth (optional; only needed if the project gates its
# own deployed AJS endpoints on a shared secret, independent of the S1 session —
# e.g. ofertainvest's public/AJS/WS.js assertAuthorized). Auto-injected as
# authKey into any call whose path starts with S1_CUSTOM_WS_PREFIX. ---
S1_CUSTOM_WS_PREFIX=/JS/WS/
S1_WS_SHARED_SECRET=

# --- Write gate (required to enable s1_insert / s1_update / s1_execute_sql_write / s1_deploy_ajs_script commit=true) ---
# off  (default) - all write tools fail closed, regardless of the commit param.
# test           - writes allowed only when the effective env resolves to "test".
# all             - writes allowed against both test and prod.
S1_WRITE_MODE=off
